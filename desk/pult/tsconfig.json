{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "resolveJsonModule": true,
    "paths": {
      "@tauri-apps/api/*": [
        "./node_modules/@tauri-apps/api/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
